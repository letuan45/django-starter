# Copy to .env and fill in real values. .env is git-ignored; this file is not.
# This file is the checked-in list of every variable the project needs.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
# POSTGRES_HOST is the Compose service name, not localhost: containers resolve
# each other by service name on the Compose network.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=replace-me

# --- MongoDB (unused until Phase 9) ---------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=library_activity

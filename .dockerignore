# Everything here is excluded from the build context — the tarball the Docker
# CLI ships to the daemon before the first instruction runs.
# Smaller context = faster builds, and no chance of a secret landing in a layer.

.git
.gitignore
.venv
venv
__pycache__/
*.py[cod]
*.stackdump
.vscode
.idea

# Never, under any circumstance, inside an image.
.env
.env.*
!.env.example

docs/
